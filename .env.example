# Copy to .env and adjust. Never commit .env (it is gitignored).
#
# What milestones 1 and 2 need — which is very little, and deliberately so.
# Nothing here is a secret: there is no provider to hold a key for until
# generation arrives, and the whole test suite runs with nothing set at all.
#
# Settings arrive with the milestone that reads them.

# --- App ---
KNOWLEDGEOS_APP_NAME=KnowledgeOS
KNOWLEDGEOS_ENVIRONMENT=local
# SQLAlchemy statement echoing. Leave false: echoed SQL carries document
# titles and filenames into the log.
KNOWLEDGEOS_DEBUG=false

# --- Database ---
# PostgreSQL 16 with the pgvector extension, over psycopg 3. This is the only
# datastore this project has and the only one it will get.
#
# Alembic reads this same setting through app/config.py, so migrations and the
# running application cannot disagree about which database they are using.
# alembic.ini deliberately contains no URL.
KNOWLEDGEOS_DATABASE_URL=postgresql+psycopg://knowledgeos:knowledgeos@localhost:5432/knowledgeos

# Used only by the test suite, which migrates this database down to nothing on
# every run — never point it at the database above. The fixtures refuse any
# name that does not end in `_test`.
KNOWLEDGEOS_TEST_DATABASE_URL=postgresql+psycopg://knowledgeos:knowledgeos@localhost:5432/knowledgeos_test

# --- Uploads ---
# Where uploaded files are kept. A relative path resolves against the project
# root, and `var/` is gitignored. The database stores paths relative to this,
# so moving the root does not invalidate a row.
KNOWLEDGEOS_STORAGE_ROOT=var/documents

# The largest upload accepted, in bytes. Enforced while reading the body in
# bounded chunks — never from the Content-Length header, which the client
# chose. 25 MiB.
KNOWLEDGEOS_MAX_UPLOAD_BYTES=26214400

# The formats this system accepts. An extension accepted here that nothing can
# later parse would be an upload that succeeds and an ingestion job that fails.
KNOWLEDGEOS_ALLOWED_EXTENSIONS=[".pdf",".docx",".md",".markdown",".txt"]
