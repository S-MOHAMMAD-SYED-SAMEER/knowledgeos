# Copy to .env and adjust. Never commit .env (it is gitignored).
#
# The full milestone 1-10 configuration surface. Every value below has a
# working default and the whole test suite runs with nothing set at all —
# nothing here is required just to run `pytest`. Two values genuinely have
# no default and must be set before the feature they gate will work:
# `KNOWLEDGEOS_LLM_MODEL` (generation) and a Gemini credential in the
# process environment, neither of which is a `KNOWLEDGEOS_`-prefixed
# setting — see "Generation" below for why.
#
# Settings arrive with the milestone that reads them.

# --- App ---
KNOWLEDGEOS_APP_NAME=KnowledgeOS
KNOWLEDGEOS_ENVIRONMENT=local
# SQLAlchemy statement echoing. Leave false: echoed SQL carries document
# titles and filenames into the log.
KNOWLEDGEOS_DEBUG=false

# --- Demo (public standalone deployment) ---
# Off by default — normal/Live Mode behaviour is unchanged unless an
# operator deliberately opts in. When true, `app/api/query.py::llm_provider`
# resolves to the application's own `DemoLLMProvider` instead of the real
# Gemini adapter, and `app/api/demo_guard.py::require_mutation_allowed`
# refuses `POST /documents`, `POST /documents/{id}/versions`, `POST
# /documents/{id}/reindex`, and both feedback routes with 403. See
# docker-compose.demo.yml for how the standalone demo deployment sets this.
KNOWLEDGEOS_DEMO_MODE=false

# Also off by default. When true, `POST /query` and `POST /ui/query` refuse
# a request over the per-minute count below from the same client IP, with
# 429 — see app/api/rate_limit.py. In-process only; nothing here needs
# Redis or a database table.
KNOWLEDGEOS_DEMO_RATE_LIMIT_ENABLED=false
# Queries allowed per client IP per minute, while the flag above is true.
# Optional — the default is 10.
KNOWLEDGEOS_DEMO_RATE_LIMIT_PER_MINUTE=10

# --- Database ---
# PostgreSQL 16 with the pgvector extension, over psycopg 3. This is the only
# datastore this project has and the only one it will get.
#
# Alembic reads this same setting through app/config.py, so migrations and the
# running application cannot disagree about which database they are using.
# alembic.ini deliberately contains no URL.
KNOWLEDGEOS_DATABASE_URL=postgresql+psycopg://knowledgeos:knowledgeos@localhost:5432/knowledgeos

# Used only by the test suite, which migrates this database down to nothing on
# every run — never point it at the database above. The fixtures refuse any
# name that does not end in `_test`.
KNOWLEDGEOS_TEST_DATABASE_URL=postgresql+psycopg://knowledgeos:knowledgeos@localhost:5432/knowledgeos_test

# --- Uploads ---
# Where uploaded files are kept. A relative path resolves against the project
# root, and `var/` is gitignored. The database stores paths relative to this,
# so moving the root does not invalidate a row.
KNOWLEDGEOS_STORAGE_ROOT=var/documents

# The largest upload accepted, in bytes. Enforced while reading the body in
# bounded chunks — never from the Content-Length header, which the client
# chose. 25 MiB.
KNOWLEDGEOS_MAX_UPLOAD_BYTES=26214400

# The formats this system accepts. An extension accepted here that nothing can
# later parse would be an upload that succeeds and an ingestion job that fails.
KNOWLEDGEOS_ALLOWED_EXTENSIONS=[".pdf",".docx",".md",".markdown",".txt"]

# --- Chunking ---
# The specification's terminology is "tokens" and these keep its names. The
# unit milestone 3 counts is a **whitespace-delimited word**: no tokenizer is
# specified anywhere, and using the embedding model's own would mean
# downloading a model asset. The consequence at milestone 4 is real and is
# recorded in the README: a 512-word chunk is not a 512-token chunk, and the
# embedding model truncates at its own limit.
KNOWLEDGEOS_CHUNK_SIZE_TOKENS=512
KNOWLEDGEOS_CHUNK_OVERLAP_TOKENS=64

# --- Ingestion runner ---
# How often the runner looks for queued jobs. Polling rather than an
# in-process background task, so a job survives a restart.
KNOWLEDGEOS_INGESTION_POLL_SECONDS=5.0
# How many times a job may be tried before it is left failed. The
# specification requires retries "bounded by attempts" and names no number,
# so the number lives here rather than in the code.
KNOWLEDGEOS_MAX_ATTEMPTS=3
# A document takes two of these attempts to reach `ready`: one claim parses
# and chunks it, a second indexes it. `attempts` counts job attempts, not
# stage attempts, so keep this at 2 or more.

# --- Embeddings ---
# There is nothing to configure here, and that is the design. The model is
# `BAAI/bge-small-en-v1.5` at 384 dimensions, both fixed by the specification
# and both compiled into the schema: `chunks.embedding` is `vector(384)`, so a
# model of another width could not be swapped in by an environment variable
# without a migration. Swapping the model means writing another
# `EmbeddingProvider` — see app/providers/embeddings.py.
#
# It runs locally, in this process, from the sentence-transformers cache
# (`HF_HOME`, by default ~/.cache/huggingface). Nothing is sent anywhere and
# no API key exists to set.

# --- Reranking ---
# Also nothing to configure. The model is `cross-encoder/ms-marco-MiniLM-
# L-6-v2`, fixed by the specification. Swapping it means writing another
# `RerankProvider` — see app/providers/reranker.py — not an environment
# variable.
#
# Runs locally, from the same sentence-transformers cache as the embedding
# model above. No API key, no network at run time.

# --- Retrieval (milestone 5) ---
# Reciprocal Rank Fusion's own constant. The specification fixes the
# formula and calls only this part of it "configurable"; the per-channel
# candidate limit (50) and the count handed to reranking (20) are facts
# the specification states, not settings. Optional — the default is 60.
KNOWLEDGEOS_RRF_K=60

# The longest `POST /query` query accepted before an honest 422, rather
# than a silent truncation that would embed a different query than the
# one typed. Optional — the default is 1000 characters.
KNOWLEDGEOS_QUERY_MAX_LENGTH=1000

# --- Generation (milestone 8) ---
# REQUIRED before POST /query or the UI's query box can generate an
# answer — no default. The generation provider for this build is Google
# Gemini, not Anthropic (a documented deviation from the specification's
# stack wording; see the README's milestone 8 section). Set this only
# once you have verified a real, available model against the live API
# (`client.models.list()`) — never guessed from memory.
# KNOWLEDGEOS_LLM_MODEL=

# The Gemini credential itself is intentionally **not** a
# `KNOWLEDGEOS_`-prefixed setting: `google.genai.Client()` resolves it
# from the process environment on its own
# (`app/providers/gemini_llm.py`), and this application's own code never
# reads it, logs it, or passes it through `app/config.py` — one fewer
# place a key could leak into a log line or an error response. Set
# GEMINI_API_KEY (or GOOGLE_API_KEY, which the SDK prefers if both are
# set) directly in the process environment, never here as a
# `KNOWLEDGEOS_`-prefixed value.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# The longest generated answer, in output tokens. The specification names
# no cap. Optional — the default is 2048.
KNOWLEDGEOS_LLM_MAX_OUTPUT_TOKENS=2048

# The rerank-score abstention trigger. The specification requires this to
# be "calibrated on a dev split of the eval questions, not chosen by
# taste" (§9) — `evals/answers/calibration.py` (milestone 9) is that
# procedure. Optional, and unset by default: `None` means the score-based
# trigger is inactive (only a zero-candidate result or the model's own
# `sufficient_evidence=false` can abstain); only a genuinely calibrated
# run should set this, with the calibration documented alongside it.
# KNOWLEDGEOS_ABSTENTION_RERANK_THRESHOLD=

# --- Observability / cost (milestone 9) ---
# Per-model pricing, in USD per **million** tokens — the unit vendor
# pricing pages conventionally publish in. JSON:
# `{"<model name>": {"input": <usd/1M tokens>, "output": <usd/1M tokens>}}`.
# Optional, and empty by default: the specification requires unknown
# pricing to raise a config error rather than silently become zero (§14),
# so cost tracking stays inactive (`cost_usd` is left `NULL`) until a
# real, verified rate is entered here — never invented for an unverified
# model.
# KNOWLEDGEOS_LLM_PRICING_USD_PER_MILLION_TOKENS={}

# --- Deployment (milestone 10) ---
# Inside the Docker image (see Dockerfile / docker-compose.yml), the
# storage root and the database host both change from the local defaults
# above:
#   KNOWLEDGEOS_STORAGE_ROOT=/var/lib/knowledgeos/storage   (absolute —
#     a relative path would resolve against the container's working
#     directory, not a mounted volume)
#   KNOWLEDGEOS_DATABASE_URL=postgresql+psycopg://knowledgeos:knowledgeos@db:5432/knowledgeos
#     (the compose service name `db`, not `localhost`)
# `docker-compose.yml` sets both for you; nothing above needs to change
# for a local, non-containerized run.
